# KRINO WORLD 海外版（Global edition）的配置。复制为 .env.global，然后：
#   ENV_FILE=.env.global scripts/world.sh start
# 海外版是独立的一套部署：英文界面和角色、英文商标、自己的数据库（用户数据不和国内版互通）。
# 正式上线时国内版和海外版分别部署在国内和海外的服务器上，用同一个域名，由 DNS 按访问者所在地区解析到不同服务器（见 docs/DEPLOY.md）。

SITE_EDITION=global
DATABASE_URL=postgresql+psycopg://krino:krino@localhost:5433/krino_world_global
HOST=0.0.0.0
PORT=8631

# LLM：海外服务器直连 OpenRouter
LLM_PROVIDER=openrouter
LLM_MODEL=~deepseek/deepseek-flash-latest
# OPENROUTER_API_KEY=

# 本地英文语音（Kokoro：af_maple / af_sol 美式，bf_vale 英式）
TTS_PROVIDER=local
# TTS_DEFAULT_VOICE=af_maple

VLM_PROVIDER=mock
STT_PROVIDER=browser
KRINO_POLICY=rules
# WORKSHOP_ADMINS=
# 国内版的网址：页脚显示“中国大陆”切换链接
# OTHER_EDITION_URL=https://cn.krinomatrix.com
