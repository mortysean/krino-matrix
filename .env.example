# Copy this file to .env and fill in your own values. .env is git-ignored.
#
# Models are always named in OpenRouter format, e.g. deepseek/deepseek-v4.1-flash
# (see https://openrouter.ai/models), and used as LLM("<model>").
#
# Providers are the endpoints that serve them. For each model, the first provider in
# LLM_PROVIDERS whose LLM_<NAME>_MODELS matches is used. Per provider:
#   LLM_<NAME>_BACKEND            openrouter: via OpenRouter
#                                 litellm:    direct provider through litellm, model name sent unchanged
#                                 anthropic:  official Anthropic SDK, for gateways that only accept it
#   LLM_<NAME>_API_BASE           custom endpoint, e.g. a relay/proxy (optional)
#   LLM_<NAME>_API_KEY            API key (optional; falls back to the backend's standard env var
#                                 such as OPENROUTER_API_KEY / ANTHROPIC_API_KEY)
#   LLM_<NAME>_MODELS             comma-separated glob patterns, e.g. anthropic/*,openai/gpt-5 (default *)
#   LLM_<NAME>_NATIVE_STRUCTURED  false if the endpoint rejects native structured output;
#                                 JSON is then enforced via prompt (default true)

# Model used by LLM() when no model is given. The ~...-latest alias always resolves to the newest
# release on OpenRouter; LLM.served_model reports the concrete version behind it.
LLM_DEFAULT=~deepseek/deepseek-flash-latest

LLM_PROVIDERS=openrouter

LLM_OPENROUTER_BACKEND=openrouter
LLM_OPENROUTER_API_KEY=
LLM_OPENROUTER_MODELS=*

# Example: Claude through the official Anthropic API (add "anthropic" before openrouter in LLM_PROVIDERS)
# LLM_ANTHROPIC_BACKEND=anthropic
# LLM_ANTHROPIC_API_KEY=
# LLM_ANTHROPIC_MODELS=anthropic/*

# Example: Claude through an Anthropic-compatible relay
# LLM_RELAY_BACKEND=anthropic
# LLM_RELAY_API_BASE=https://your-relay.example.com
# LLM_RELAY_API_KEY=
# LLM_RELAY_MODELS=anthropic/claude-opus-5.5

# sagax data platform (https://www.sagax.cn/data/v1/), used by krino/data/sagax
SAGAX_API_KEY=
SAGAX_SECRET_KEY=
# SAGAX_BASE_URL=https://api.sagax.cn/data/v1

# ====================== KRINO WORLD（backend/，scripts/world.sh） ======================
# 站点版本：cn = 国内版（中文、中文商标、页脚备案号）| global = 海外版（英文，配置见 .env.global.example）
SITE_EDITION=cn
# ICP_NUMBER=浙ICP备2026093639号        # 国内版页脚显示，点击跳转工信部备案查询
# POLICE_RECORD_NUMBER=浙公网安备 33010XXXXXXXXXX号
# OTHER_EDITION_URL=https://global.krinomatrix.com   # 海外版网址：页脚显示 “Global” 切换链接
# 所有数据都在 PostgreSQL。scripts/world.sh db init 会在 data/pgdata/ 建一个本地库（端口 5433）
DATABASE_URL=postgresql+psycopg://krino:krino@localhost:5433/krino_world
HOST=127.0.0.1
PORT=8630

# LLM：openrouter | mock（离线模板，只用于演示和测试）。密钥用上面的 LLM_OPENROUTER_API_KEY 或 OPENROUTER_API_KEY
LLM_PROVIDER=openrouter
LLM_MODEL=~deepseek/deepseek-flash-latest
# LLM_CHARACTER_MODELS=~deepseek/deepseek-flash-latest   # 角色可选的聊天模型（白名单，第一个是默认）
# LLM_REASONING=off                                     # off | low | medium | high
# LLM_TIMEOUT_S=60

# VLM（上传图像 / 眼镜画面理解）：mock 只读颜色亮度，明确标注为模拟 | openai = OpenAI 兼容接口
VLM_PROVIDER=mock
# VLM_BASE_URL=https://openrouter.ai/api/v1
# VLM_MODEL=
# VLM_API_KEY=

# 语音：browser = 浏览器自带（默认）| openai = OpenAI 兼容接口，由服务端转发（密钥不进浏览器）| mock = 测试
STT_PROVIDER=browser
# STT_BASE_URL=https://api.openai.com/v1
# STT_MODEL=whisper-1
# STT_API_KEY=
# TTS：dashscope = 阿里云百炼 Qwen-Audio 3.1（国内版推荐，按人设描述说话）| elevenlabs = Eleven v4（语音榜第 1，海外版推荐）| openai = OpenAI
#      | qwen = 自建 Qwen3-TTS（要显卡）| local = 本地 Kokoro（免费离线）| browser | mock
#      除 browser / mock 外，出错或没配密钥时都自动退回 Kokoro。声音描述在 app/tts/voices.py。
TTS_PROVIDER=local
# DASHSCOPE_API_KEY=            # 百炼控制台 → API-KEY（北京地域）
# DASHSCOPE_TTS_MODEL=qwen-audio-3.1-tts-plus   # 便宜些用 qwen-audio-3.1-tts-flash；旧版 qwen3-tts-instruct-flash
# DASHSCOPE_WORKSPACE=          # 百炼控制台 → 业务空间 ID；接口报 404 时填上
# DASHSCOPE_VOICE_MAP=dafeiyu-zh=longanhuan_v3.1,krino-zh=longanlingxin_v3.1
# ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_v4    # 要更快用 eleven_v4_turbo

# 外观工作台（导航“02 工作台”左栏）：一句话生成立绘、在当前这张上修改、一键生成整套表情。共用 DASHSCOPE_API_KEY
# IMAGE_PROVIDER=dashscope      # dashscope = 百炼千问图像 | mock = 测试用色块
# IMAGE_MODEL=qwen-image-3.0    # 更精细用 qwen-image-3.0-pro
# IMAGE_DAILY_LIMIT=40          # 每人每天最多生成几张（一套表情算 10 张）
# IMAGE_USER_LIMITS=krino_demo:20   # 个别账号单独的每日张数（比如测试账号），用逗号分隔多个

# 联网：聊天时她觉得需要（问天气、新闻……）才会上网查，走 OpenRouter 的 openrouter:web_search（共用 OPENROUTER_API_KEY）。
# 每查一次约 0.007 美元（≈0.5 积分），算进积分。用户可以在设置里关掉
# WEB_SEARCH=exa                # exa | parallel | perplexity | auto | off
# WEB_SEARCH_RESULTS=5          # 每次搜几条
# WEB_SEARCH_MAX_USES=2         # 一句回复最多搜几次

# 积分：对话的 token、生成的图片、云端语音都折成积分（1 元 = 10 积分），按天限额。设了积分上限的账号不再按上面的张数限
# CREDITS_PER_CNY=10
# CREDIT_DAILY_LIMIT=0               # 每人每天多少积分，0 = 不限
# CREDIT_USER_LIMITS=krino_demo:1000 # 个别账号单独的上限（1000 积分 = 每天 100 元），用逗号分隔多个
# 单价（估算，按你的实际账单改）：对话优先用 OpenRouter 返回的实际花费，没有时按 token 单价
# USD_CNY=7.2
# LLM_PRICE_IN=2                     # 元 / 百万输入 token
# LLM_PRICE_OUT=8                    # 元 / 百万输出 token
# IMAGE_PRICE_CNY=0.25               # 元 / 张
# TTS_PRICE_CNY=1                    # 元 / 万字（本地 Kokoro、浏览器朗读不计）
# MEDIA_DIR=data/media          # 生成的立绘存在这里；部署时不会被覆盖
# OPENAI_API_KEY=
# TTS_MODEL=gpt-4o-mini-tts
# TTS_VOICE_MAP=dafeiyu-zh=Cherry,krino-zh=Serena,dafeiyu-en=coral,krino-en=sage   # 角色 → 平台音色
# TTS_DEFAULT_VOICE=zf_001      # Kokoro：角色没选音色时用；zf_* 女声，zm_* 男声
# KOKORO_DIR=data/models/kokoro-zh

# KRINO Evaluator 互动策略：rules（规则，默认）| matrix（3-Head 模型，实验）| off
KRINO_POLICY=rules
# KRINO_MATRIX_CHECKPOINT=model/checkpoints/mmbert-uncertainty

# 创意工坊：管理员用户名（逗号分隔）；被几个人举报后自动隐藏；新作品是否要先审核
# WORKSHOP_ADMINS=
# WORKSHOP_AUTO_HIDE_REPORTS=3
# WORKSHOP_REQUIRE_REVIEW=0

# 上限
# COMPANION_LIMIT=8
# MAX_IMPORT_BYTES=12582912
# MAX_IMAGE_BYTES=4194304
# MAX_AUDIO_BYTES=10485760
